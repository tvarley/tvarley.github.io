---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import { getSeriesNavigation, writingHref } from '../lib/series';

interface Props {
	currentPost?: CollectionEntry<'writings'> | null;
}

const { currentPost } = Astro.props;

const allPosts = await getCollection('writings');
const { seriesPosts, prevPost, nextPost, currentIndex, seriesTitle } =
	getSeriesNavigation(allPosts, currentPost);

const showNav = seriesPosts.length > 1 && currentIndex >= 0;
---

{showNav && (
	<nav class="mt-12 space-y-6 border-t border-white/10 pt-8" aria-label="Series previous and next">
		<div class="grid grid-cols-2 gap-4">
			{prevPost ? (
				<a
					href={writingHref(prevPost)}
					class="group flex flex-col items-start p-4 rounded-xl hover:bg-white/5 transition-all text-left border border-white/5 hover:border-white/10"
				>
					<span class="text-xs font-mono text-steel-grey mb-1 group-hover:text-steel-blue transition-colors">
						← Previous
					</span>
					<span class="text-white font-serif font-bold text-lg group-hover:translate-x-1 transition-transform">
						{prevPost.data.title}
					</span>
				</a>
			) : (
				<div></div>
			)}

			{nextPost ? (
				<a
					href={writingHref(nextPost)}
					class="group flex flex-col items-end p-4 rounded-xl hover:bg-white/5 transition-all text-right border border-white/5 hover:border-white/10"
				>
					<span class="text-xs font-mono text-steel-grey mb-1 group-hover:text-steel-blue transition-colors">
						Next →
					</span>
					<span class="text-white font-serif font-bold text-lg group-hover:-translate-x-1 transition-transform">
						{nextPost.data.title}
					</span>
				</a>
			) : (
				<div></div>
			)}
		</div>

		<div class="text-center">
			<div class="text-sm font-mono text-steel-grey">
				Part {currentIndex + 1} of {seriesPosts.length}
			</div>
			{seriesTitle && (
				<div class="text-xs text-steel-grey/70 mt-1">{seriesTitle}</div>
			)}
		</div>
	</nav>
)}
